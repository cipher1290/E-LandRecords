      return NextResponse.json(
        { error: 'Failed to regenerate Patta certificate' },
        { status: 500 }
      );
    }
  } catch (error) {
    console.error('Error regenerating Patta:', error);
    return NextResponse.json(
      { error: 'Internal server error' },
      { status: 500 }
    );
  }
}
