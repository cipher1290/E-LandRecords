	return &readWriteSet{rwSet}
}

func (p *readWriteSet) namespaceReadWriteSets() []*NamespaceReadWriteSet {
	result := []*NamespaceReadWriteSet{}
	for _, nsReadWriteSet := range p.readWriteSet.GetNsRwset() {
