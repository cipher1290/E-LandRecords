    } catch (fabricError) {
      console.error('Fabric connection failed:', fabricError);
      return res.status(500).json({ error: 'Failed to connect to blockchain network' });
    }

    // Generate JWT token
    const token = jwt.sign(
      {
        username,
        role: user.role,
        org: user.org,
        orgNumber: user.org.replace('org', '')
      },
      JWT_SECRET,
