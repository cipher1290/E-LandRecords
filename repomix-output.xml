      const data = await response.json();

      if (!response.ok) {
        setErrors(data.errors || { submit: data.message || 'Failed to send OTP' });
      } else {
        setShowOTPModal(true);
        setErrors({});
      }
    } catch (error) {
      setErrors({ submit: 'An error occurred. Please try again.' });
    } finally {
      setLoading(false);
    }
  };

