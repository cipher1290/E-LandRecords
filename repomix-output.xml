#
# SPDX-License-Identifier: Apache-2.0
#
---
apiVersion: batch/v1
kind: Job
metadata:
  name: job-scrub-fabric-volumes
spec:
  backoffLimit: 0
  completions: 1
  template:
    metadata:
      name: job-scrub-fabric-volumes
    spec:
      restartPolicy: "Never"
      containers:
        - name: main
          image: busybox:latest
          command:
            - sh
            - -c
            - "rm -rvf /mnt/fabric-*/*"
          volumeMounts:
            - name: fabric-org2-volume
              mountPath: /mnt/fabric-org2
      volumes:
        - name: fabric-org2-volume
          persistentVolumeClaim:
            claimName: fabric-org2
</file>

