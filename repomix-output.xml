                      <td className="px-6 py-4">
                        <button
                          onClick={() => setSelectedApp(app)}
                          className={`text-sm font-bold px-4 py-2 rounded-lg transition-all duration-200 shadow-sm hover:shadow-md ${roleColors.button}`}
                        >
                          Review Application
                        </button>
                      </td>
                    </tr>
                  ))
                )}
              </tbody>
            </table>
          </div>
        </div>
      </div>
    </div>
  );
}
