              {/* Documents */}
              <div className="mb-8">
                <h3 className="text-lg font-bold text-white mb-4">Uploaded Documents</h3>
                {selectedApp.documents && selectedApp.documents.length > 0 ? (
                  <div className="grid grid-cols-2 gap-3">
